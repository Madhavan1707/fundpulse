# Secrets — NEVER commit. Local testing of the alert engine / news fetcher
# reads these; they belong only in GitHub Actions secrets.
.env
.env.*
!.env.example
*.pem
*.key

# Supabase CLI local state (contains project linkage + local tokens)
supabase/.temp/
supabase/.branches/

# Node
node_modules/
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# gstack / Claude local tooling
.gstack/
.claude/

# Superpowers planning docs — local working notes from the build, not project
# documentation. Heads up: four files here (the 2026-05-26 alert-engine and
# 2026-05-30 phone-verification plans/specs) were committed before this rule
# and stay tracked, because .gitignore does not retroactively untrack anything.
# `git rm --cached -r docs/superpowers/` if you want the whole directory local.
docs/superpowers/
